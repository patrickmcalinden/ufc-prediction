# Secrets — NEVER commit
.env
.env.*
!.env.example
*.env
*.env.local
.env.local
secrets/

# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Node / Next.js site
node_modules/
site/.next/
site/out/
# NOTE: site/public/data/ is NOT ignored — GitHub Pages needs the static
# JSON files committed to serve the site. Re-export by running the
# pipeline (see REWRITE_PLAN.md).

# Model artifacts (large binary files)
model/artifacts/*.json

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local Claude Code permissions / state
.claude/settings.local.json
.claude/worktrees/

# Legacy / unused files
*.UNUSED.md
