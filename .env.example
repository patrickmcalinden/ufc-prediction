# .env.example

# Database
# When running inside docker, the host might be 'db'. Locally with docker mapped to 5432, it's localhost.
DATABASE_URL=postgresql://ufc_user:ufc_password@localhost:5432/ufc_predictor

# API
API_HOST=0.0.0.0
API_PORT=8000

# Bet tracker write access (required for POST /bets and PATCH /bets/settle)
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
BET_API_KEY=your-secret-key-here

# Frontend (Vite prefix required)
VITE_API_URL=http://localhost:8000

# Model
MODEL_ARTIFACT_PATH=model/artifacts/xgb_v1.json
